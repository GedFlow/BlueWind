<?xml version="1.0" encoding="utf-8"?>
<!--
    앱 아이콘 전경: 바람(Wind)이 창문(Windows)을 미는 모습.
    왼쪽 바람 세 줄기 + 바람에 밀려 10° 기울어진 창문(일반 창틀, 4칸 유리).
    모든 요소는 적응형 아이콘 안전 영역(가운데 지름 66dp 원) 안에 들어간다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 그림 전체를 가운데 정렬 (중심 53.9,55 → 54,54, 0.95배) -->
    <group
        android:pivotX="53.9"
        android:pivotY="55"
        android:scaleX="0.95"
        android:scaleY="0.95"
        android:translateX="0.1"
        android:translateY="-1">
        <!-- 바람 -->
        <path
            android:pathData="M27,47 H47 A4.5,4.5 0 1 0 42.5,42.5"
            android:strokeWidth="4"
            android:strokeColor="#FFBFE3FF"
            android:strokeLineCap="round" />
        <path
            android:pathData="M24,55 H54"
            android:strokeWidth="4"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />
        <path
            android:pathData="M29,63 H45 A4.5,4.5 0 1 1 40.5,67.5"
            android:strokeWidth="4"
            android:strokeColor="#FFBFE3FF"
            android:strokeLineCap="round" />
        <!-- 창문 (바람에 밀려 10° 기울어짐) -->
        <group
            android:pivotX="70.5"
            android:pivotY="54"
            android:rotation="10">
            <path
                android:fillAlpha="0.22"
                android:fillColor="#FFFFFFFF"
                android:pathData="M61.5,39 H79.5 A2.5,2.5 0 0 1 82,41.5 V66.5 A2.5,2.5 0 0 1 79.5,69 H61.5 A2.5,2.5 0 0 1 59,66.5 V41.5 A2.5,2.5 0 0 1 61.5,39 Z" />
            <path
                android:pathData="M61.5,39 H79.5 A2.5,2.5 0 0 1 82,41.5 V66.5 A2.5,2.5 0 0 1 79.5,69 H61.5 A2.5,2.5 0 0 1 59,66.5 V41.5 A2.5,2.5 0 0 1 61.5,39 Z"
                android:strokeWidth="3.4"
                android:strokeColor="#FFFFFFFF" />
            <path
                android:pathData="M70.5,39 V69 M59,54 H82"
                android:strokeWidth="2.6"
                android:strokeColor="#FFFFFFFF" />
        </group>
    </group>
</vector>
